ANTHROPIC_API_KEY=your_key_here
WIZARD_DB_PATH=~/.wizard/cards.db
WIZARD_MODEL=claude-sonnet-4-6
WIZARD_MAX_OUTPUT_TOKENS=8192

# Backend: auto | algorithmic | ollama | anthropic (default: auto)
WIZARD_BACKEND=auto

# Ollama settings (only needed if WIZARD_BACKEND=ollama)
WIZARD_OLLAMA_URL=http://localhost:11434
WIZARD_OLLAMA_MODEL=llama3.1
